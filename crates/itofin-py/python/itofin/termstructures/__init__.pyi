        The SABR rho parameter.

        Returns:
            float: The rho the smile was built with.
        """
    def __init__(self, exercise_time: builtins.float, forward: builtins.float, alpha: builtins.float, beta: builtins.float, nu: builtins.float, rho: builtins.float, shift: builtins.float = 0.0, volatility_type: VolatilityType = VolatilityType.ShiftedLognormal) -> None:
